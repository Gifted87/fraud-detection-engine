# Fraud Detection Engine Configuration Example

# Security Keys
SIGNING_KEY=your-secret-signing-key-for-hmac
ENCRYPTION_KEY=your-aes-256-encryption-key-passphrase

# Cryptographic salt for AES-256-GCM key derivation (scrypt).
# MUST be a unique, randomly generated string per deployment (min 16 chars).
# WARNING: Changing this value means previously-encrypted data cannot be decrypted.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRYPTO_SALT=generate-a-unique-random-salt-per-deployment

# PEM-encoded RSA/Ed25519 Public/Private Keys (replace \n with real newlines or keep \n for replacement)
PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Persistence Layer
REDIS_URL=redis://localhost:6379
DB_URL=postgres://user:password@localhost:5432/fraud_db
DB_POOL_MIN=2
DB_POOL_MAX=10

# Messaging Client
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=fraud-detection-engine
KAFKA_GROUP_ID=fraud-detection-group

# Environment
NODE_ENV=development
FRAUD_THRESHOLD=0.5
VELOCITY_THRESHOLD=10
VELOCITY_WINDOW_SECONDS=60

# Merchant sanctions list (comma-separated merchant IDs).
# Hot-reloadable via SIGHUP — no process restart needed.
MERCHANT_BLACKLIST=

# PostgreSQL serialization-failure retry attempts (default: 3)
PG_MAX_SERIALIZATION_RETRIES=3

# Kafka consumer: max transient-error retries before routing to DLQ (default: 3)
MAX_CONSUMER_RETRIES=3

# Kafka consumer: number of messages processed in parallel per batch window (default: 50)
CONSUMER_CONCURRENCY=50
