# Fraud Detection Engine Configuration Example

# Security Keys
SIGNING_KEY=your-secret-signing-key-for-hmac
ENCRYPTION_KEY=your-aes-256-encryption-key-passphrase

# PEM-encoded RSA/Ed25519 Public/Private Keys (replace \n with real newlines or keep \n for replacement)
PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Persistence Layer
REDIS_URL=redis://localhost:6379
DB_URL=postgres://user:password@localhost:5432/fraud_db
DB_POOL_MIN=2
DB_POOL_MAX=10

# Messaging Client
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=fraud-detection-engine
KAFKA_GROUP_ID=fraud-detection-group

# Environment
NODE_ENV=development
FRAUD_THRESHOLD=0.5
VELOCITY_THRESHOLD=10
VELOCITY_WINDOW_SECONDS=60
