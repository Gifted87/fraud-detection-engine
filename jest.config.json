{
  "preset": "ts-jest",
  "testEnvironment": "node",
  "roots": ["<rootDir>/src"],
  "testMatch": ["**/*.test.ts", "**/*.spec.ts"],
  "transform": {
    "^.+\\.ts$": "ts-jest"
  },
  "moduleNameMapper": {
    "../utils/security/security_manager": "<rootDir>/src/utils/security/crypto"
  },
  "testTimeout": 120000
}
